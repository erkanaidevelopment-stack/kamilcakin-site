---
// Klasik eserler koleksiyonundan, altın yaldızlı ciltlerle dolu bir kitap rafı çizer.
// Yönetim panelinden eser eklendikçe ya da çıkarıldıkça raf kendiliğinden yeniden dizilir.
import { renk } from '../lib/site';
interface Props { eserler: any[] }
const { eserler } = Astro.props;

const GEN = [62, 58, 52, 66, 54, 56, 54, 64, 58, 56, 60, 52, 62, 50, 52];
const YUK = [270, 255, 232, 280, 245, 258, 250, 272, 250, 262, 276, 240, 282, 250, 250];
const ZEMIN = 300;
const n = eserler.length;
const yiginSonra = n >= 10 ? Math.ceil(n / 2) - 1 : -1; // ortadaki yatay kitap yığını
const egikIndis = n >= 6 ? n - 2 : -1;

type Cilt = { x: number; w: number; h: number; e: any; egik: boolean; latinBoy: number; arBoy: number; r: { ana: string; koyu: string; ic: string } };
const ciltler: Cilt[] = [];
let x = 40;
let yigin: { x: number } | null = null;
eserler.forEach((e, i) => {
  const w = GEN[i % GEN.length];
  const h = YUK[i % YUK.length];
  const bolge = h - 134;
  const latin = String(e.data.baslik);
  const latinBoy = Math.max(11, Math.min(17, bolge / (latin.length * 0.5)));
  const ar = String(e.data.sirtYazisi || e.data.arapca);
  const arBoy = Math.max(9, Math.min(13, (w - 14) / (ar.length * 0.5)));
  ciltler.push({ x, w, h, e, egik: i === egikIndis, latinBoy, arBoy, r: renk(e.data.renk) });
  x += w + 2;
  if (i === egikIndis) x += Math.round(h * 0.208) + 4;
  if (i === yiginSonra) { yigin = { x: x + 14 }; x += 210; }
});
const genislik = x + 40;
const isimler = eserler.map((e) => e.data.baslik).join(', ');
---
<div class="raf raf-kaydir">
  <svg viewBox={`0 0 ${genislik} 350`} role="img" aria-label={`Altın yaldızlı deri ciltlerle klasik eserler rafı: ${isimler}`}>
    <defs>
      <radialGradient id="raf-isik" cx="0.3" cy="0.4" r="0.7"><stop offset="0" stop-color="#FFD98C" stop-opacity="0.20"></stop><stop offset="1" stop-color="#FFD98C" stop-opacity="0"></stop></radialGradient>
      <linearGradient id="raf-altin" x1="0" x2="1"><stop offset="0" stop-color="#7D5D1E"></stop><stop offset="0.45" stop-color="#F1D88E"></stop><stop offset="0.7" stop-color="#BE9533"></stop><stop offset="1" stop-color="#6E5018"></stop></linearGradient>
      <linearGradient id="raf-altinD" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#7D5D1E"></stop><stop offset="0.45" stop-color="#F1D88E"></stop><stop offset="0.7" stop-color="#BE9533"></stop><stop offset="1" stop-color="#6E5018"></stop></linearGradient>
      <linearGradient id="raf-ahsap" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#5A3A1E"></stop><stop offset="0.3" stop-color="#3B2614"></stop><stop offset="1" stop-color="#1C1108"></stop></linearGradient>
      <linearGradient id="raf-golge" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#000" stop-opacity="0.5"></stop><stop offset="1" stop-color="#000" stop-opacity="0"></stop></linearGradient>
      <linearGradient id="raf-huzme" x1="0" x2="1" y1="0" y2="1"><stop offset="0" stop-color="#FFE3A3" stop-opacity="0.30"></stop><stop offset="1" stop-color="#FFE3A3" stop-opacity="0"></stop></linearGradient>
      <linearGradient id="raf-deri" x1="0" x2="1"><stop offset="0" stop-color="#000" stop-opacity="0.65"></stop><stop offset="0.42" stop-color="#fff" stop-opacity="0.06"></stop><stop offset="0.72" stop-color="#000" stop-opacity="0.12"></stop><stop offset="1" stop-color="#000" stop-opacity="0.7"></stop></linearGradient>
      <linearGradient id="raf-deriD" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#000" stop-opacity="0.65"></stop><stop offset="0.42" stop-color="#fff" stop-opacity="0.06"></stop><stop offset="0.72" stop-color="#000" stop-opacity="0.12"></stop><stop offset="1" stop-color="#000" stop-opacity="0.7"></stop></linearGradient>
    </defs>
    <ellipse cx={genislik * 0.34} cy="180" rx={genislik * 0.45} ry="200" fill="url(#raf-isik)"></ellipse>

    <g font-family="'Cormorant Garamond', serif" font-weight="700" fill="#EBD394">
      {ciltler.map((c) => {
        const h = c.h; const w = c.w; const cx = w / 2;
        const ic = (
          <g transform={`translate(${c.x} ${ZEMIN - h})`}>
            <rect width={w} height={h} rx="3" fill={c.r.ana}></rect>
            <rect width={w} height={h} rx="3" fill="url(#raf-deri)"></rect>
            <rect y="10" width={w} height="3" fill="url(#raf-altin)"></rect>
            <rect y="15" width={w} height="1.2" fill="url(#raf-altin)"></rect>
            <rect x="6" y="24" width={w - 12} height="28" rx="2" fill={c.r.ic} fill-opacity="0.6" stroke="#C9A24A"></rect>
            <text x={cx} y="43" text-anchor="middle" font-family="Amiri, serif" font-size={c.arBoy} font-weight="700" fill="#F1D88E" direction="rtl">{c.e.data.sirtYazisi || c.e.data.arapca}</text>
            <rect y="60" width={w} height="4" fill="url(#raf-altin)" opacity="0.9"></rect>
            <text transform={`translate(${cx} ${(h + 10) / 2}) rotate(90)`} text-anchor="middle" dominant-baseline="central" font-size={c.latinBoy} letter-spacing="0.4">{c.e.data.baslik}</text>
            <rect y={h - 54} width={w} height="4" fill="url(#raf-altin)" opacity="0.9"></rect>
            <path d={`M${cx} ${h - 43} L${cx + 6.5} ${h - 36} L${cx} ${h - 29} L${cx - 6.5} ${h - 36} Z`} fill="url(#raf-altin)"></path>
            <rect y={h - 17} width={w} height="1.2" fill="url(#raf-altin)"></rect>
            <rect y={h - 13} width={w} height="3" fill="url(#raf-altin)"></rect>
          </g>
        );
        return c.egik ? <g transform={`rotate(12 ${c.x + w} ${ZEMIN})`}>{ic}</g> : ic;
      })}

      {yigin && (() => {
        const yx = (yigin as { x: number }).x;
        return (
          <g>
            <g>
              <rect x={yx} y="262" width="176" height="38" rx="3" fill="#714826"></rect>
              <rect x={yx} y="262" width="176" height="38" rx="3" fill="url(#raf-deriD)"></rect>
              <rect x={yx + 14} y="262" width="3" height="38" fill="url(#raf-altinD)"></rect>
              <rect x={yx + 159} y="262" width="3" height="38" fill="url(#raf-altinD)"></rect>
              <rect x={yx + 35} y="268" width="106" height="26" rx="2" fill="#120A04" fill-opacity="0.6" stroke="#C9A24A"></rect>
              <text x={yx + 88} y="281" text-anchor="middle" dominant-baseline="central" font-size="15">Kütüb-i Sitte</text>
            </g>
            <g>
              <rect x={yx + 12} y="226" width="152" height="36" rx="3" fill="#7E2329"></rect>
              <rect x={yx + 12} y="226" width="152" height="36" rx="3" fill="url(#raf-deriD)"></rect>
              <rect x={yx + 26} y="226" width="3" height="36" fill="url(#raf-altinD)"></rect>
              <rect x={yx + 147} y="226" width="3" height="36" fill="url(#raf-altinD)"></rect>
              <text x={yx + 88} y="244" text-anchor="middle" dominant-baseline="central" font-size="15">Sîre-i İbn Hişâm</text>
            </g>
            <g>
              <rect x={yx + 68} y="220" width="40" height="6" rx="1.5" fill="url(#raf-altin)"></rect>
              <rect x={yx + 68} y="170" width="40" height="6" rx="1.5" fill="url(#raf-altin)"></rect>
              <path d={`M${yx + 74} 176 Q${yx + 88} 196 ${yx + 74} 220 L${yx + 102} 220 Q${yx + 88} 196 ${yx + 102} 176 Z`} fill="#F7E7BE" fill-opacity="0.18" stroke="#D4AF5A" stroke-width="1.2"></path>
              <path d={`M${yx + 79} 214 Q${yx + 88} 202 ${yx + 97} 214 Z`} fill="#E9CF86" fill-opacity="0.8"></path>
              <rect x={yx + 71} y="176" width="2" height="44" fill="url(#raf-altin)"></rect>
              <rect x={yx + 103} y="176" width="2" height="44" fill="url(#raf-altin)"></rect>
            </g>
          </g>
        );
      })()}
    </g>

    <rect x="0" y={ZEMIN} width={genislik} height="20" fill="url(#raf-ahsap)"></rect>
    <rect x="0" y={ZEMIN} width={genislik} height="1.5" fill="#B88A45" fill-opacity="0.6"></rect>
    <rect x="0" y={ZEMIN + 20} width={genislik} height="30" fill="url(#raf-golge)"></rect>
    <polygon points={`0,0 ${genislik * 0.21},0 ${genislik * 0.61},${ZEMIN} ${genislik * 0.29},${ZEMIN}`} fill="url(#raf-huzme)"></polygon>
  </svg>
</div>
