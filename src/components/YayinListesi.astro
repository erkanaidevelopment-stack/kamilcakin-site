---
import { ayar, u } from '../lib/site';
interface Props { yayinlar: any[]; suzgec?: boolean; altMetin?: string; altBaglanti?: { href: string; ad: string } }
const { yayinlar, suzgec = true, altMetin, altBaglanti } = Astro.props;
const site = await ayar('site');
const konular = [...new Set(yayinlar.map((y) => y.data.konu).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'tr'));
const soyad = String(site.ad ?? '').trim().split(/\s+/).pop() ?? '';
const adlar = String(site.ad ?? '').trim().split(/\s+/).slice(0, -1).join(' ');
const atif = (y: any) => `${soyad}, ${adlar}. “${y.data.baslik}”. ${y.data.kunye}, ${y.data.yil}.`;
---
<div data-yayin-kutusu>
  {suzgec && konular.length > 1 && (
    <div class="suzgec" data-belir>
      <div class="cipler" role="group" aria-label="Konuya göre süz">
        <button class="cip" type="button" data-konu="" aria-pressed="true">Tümü</button>
        {konular.map((k) => <button class="cip" type="button" data-konu={k} aria-pressed="false">{k}</button>)}
      </div>
      <label class="arama">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#5E564A" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
        <span class="sr-only">Yayınlarda ara</span>
        <input type="search" placeholder="Başlık, dergi veya yıl ara" data-ara />
      </label>
    </div>
  )}
  <div class="yayin-liste" data-belir>
    {yayinlar.map((y) => (
      <div class="yayin" data-konu={y.data.konu} data-metin={`${y.data.baslik} ${y.data.kunye} ${y.data.yil} ${y.data.tur}`.toLocaleLowerCase('tr')}>
        <span class="yil">{y.data.yil}</span>
        <div class="govde">
          <b>{y.data.baslik}</b>
          <span>{y.data.tur && y.data.tur !== 'Makale' ? `${y.data.tur} · ` : ''}{y.data.kunye}</span>
          {y.data.ozet && (
            <details style="margin-top: 6px">
              <summary style="cursor: pointer; font-size: 14px; font-weight: 600; color: var(--altin-koyu)">Özeti göster</summary>
              <p style="margin: 8px 0 0; font-size: 15px; line-height: 1.65; color: var(--metin-2)">{y.data.ozet}</p>
            </details>
          )}
        </div>
        <div class="islem">
          {y.data.pdf && <a class="dugme ince" href={u(y.data.pdf)} target="_blank" rel="noopener">PDF</a>}
          {y.data.baglanti && <a class="dugme ince" href={y.data.baglanti} target="_blank" rel="noopener">Makaleye git</a>}
          <button class="dugme koyu-d ince" style="border: 0" type="button" data-kopyala={atif(y)}>Atıf kopyala</button>
        </div>
      </div>
    ))}
    <p class="bos-sonuc" hidden data-bos>Bu ölçütlere uyan yayın bulunamadı.</p>
    {(altMetin || altBaglanti) && (
      <div class="yayin-alt">
        {altMetin && <span>{altMetin}</span>}
        {altBaglanti && <a class="ok-baglanti" href={altBaglanti.href}>{altBaglanti.ad} →</a>}
      </div>
    )}
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-yayin-kutusu]').forEach((kutu) => {
    const ogeler = [...kutu.querySelectorAll<HTMLElement>('.yayin')];
    const cipler = [...kutu.querySelectorAll<HTMLButtonElement>('.cip')];
    const ara = kutu.querySelector<HTMLInputElement>('[data-ara]');
    const bos = kutu.querySelector<HTMLElement>('[data-bos]');
    let konu = '';
    const uygula = () => {
      const q = (ara?.value ?? '').trim().toLocaleLowerCase('tr');
      let gorunen = 0;
      ogeler.forEach((o) => {
        const uygun = (!konu || o.dataset.konu === konu) && (!q || (o.dataset.metin ?? '').includes(q));
        o.hidden = !uygun;
        if (uygun) gorunen++;
      });
      if (bos) bos.hidden = gorunen > 0;
    };
    cipler.forEach((c) => c.addEventListener('click', () => {
      konu = c.dataset.konu ?? '';
      cipler.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
      uygula();
    }));
    ara?.addEventListener('input', uygula);
    const istenen = new URLSearchParams(location.search).get('konu');
    if (istenen) cipler.find((c) => c.dataset.konu === istenen)?.click();
  });
</script>
