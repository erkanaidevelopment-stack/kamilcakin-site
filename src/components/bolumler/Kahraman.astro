---
import { ayar, u } from '../../lib/site';
import Sus from '../Sus.astro';
const site = await ayar('site');
const ana = await ayar('anasayfa');
const kacis = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
const slogan = kacis(String(ana.slogan ?? '')).replace(/\*(.+?)\*/g, '<em>$1</em>');
const istatistikler: { sayi: string; etiket: string }[] = ana.istatistikler ?? [];
// Fotoğraftaki pencereden yayılan, rastgele salınan ışık hüzmeleri (yalnızca havada; nesnelerin önüne geçmez).
const huzmeler = [
  { aci: 40, w: 80, o: 0.5, b: 14 }, { aci: 26, w: 130, o: 0.45, b: 22 }, { aci: 12, w: 60, o: 0.55, b: 10 },
  { aci: 0, w: 110, o: 0.5, b: 20 }, { aci: -12, w: 60, o: 0.55, b: 12 }, { aci: -26, w: 130, o: 0.45, b: 24 },
  { aci: -40, w: 90, o: 0.5, b: 16 },
];
// Fotoğraftaki nesneler (1376×768 piksellik fotoğraf koordinatları). Işığa dönük yüzleri aydınlanır, öbür yüzleri kararır.
// yon: pencereye bakan taraf; isik: ışık gradyanının başlangıç ve bitiş noktası.
type Nesne = { ad: string; nokta: number[][]; isik: [number, number, number, number] };
const nesneler: Nesne[] = [
  { ad: 'sag-ciltler', nokta: [[930, 486], [1286, 478], [1292, 708], [934, 708]], isik: [930, 0, 1292, 0] },
  { ad: 'sol-ciltler', nokta: [[56, 476], [364, 486], [364, 706], [56, 706]], isik: [364, 0, 56, 0] },
  { ad: 'sag-yigin', nokta: [[826, 562], [944, 562], [944, 664], [826, 664]], isik: [826, 0, 944, 0] },
  { ad: 'sol-yigin', nokta: [[346, 584], [546, 584], [546, 704], [346, 704]], isik: [546, 0, 346, 0] },
  { ad: 'hoca', nokta: [[604, 336], [640, 316], [702, 318], [732, 356], [732, 424], [792, 468], [818, 524], [516, 524], [546, 470], [610, 432], [604, 382]], isik: [0, 316, 0, 524] },
  { ad: 'acik-kitap', nokta: [[552, 600], [814, 600], [814, 654], [552, 654]], isik: [0, 600, 0, 654] },
];
// Masaya düşen gölgeler: tabanın konumu (yüzde) ve ışığın yönüne göre temel eğimi
const golgeler = [
  { l: 67.6, t: 92, w: 26.4, egim: 28, nesne: 0 }, { l: 4, t: 91.9, w: 22.6, egim: -28, nesne: 1 },
  { l: 60, t: 86.4, w: 8.6, egim: 18, nesne: 2 }, { l: 25.1, t: 91.6, w: 14.6, egim: -18, nesne: 3 },
];
const svg = (ic: string) => `url("data:image/svg+xml;utf8,${encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1376 768' preserveAspectRatio='none'>${ic}</svg>`)}")`;
const bulanik = `<filter id='b' x='-10%' y='-10%' width='120%' height='120%'><feGaussianBlur stdDeviation='7'/></filter>`;
const noktalar = (n: Nesne) => n.nokta.map((p) => p.join(',')).join(' ');
const maske = (n: Nesne, ters: boolean) => {
  const [x1, y1, x2, y2] = n.isik;
  const gr = `<linearGradient id='g' gradientUnits='userSpaceOnUse' x1='${x1}' y1='${y1}' x2='${x2}' y2='${y2}'><stop offset='0' stop-color='#fff' stop-opacity='${ters ? 0.15 : 1}'/><stop offset='1' stop-color='#fff' stop-opacity='${ters ? 1 : 0.15}'/></linearGradient>`;
  return svg(`<defs>${gr}${bulanik}</defs><polygon points='${noktalar(n)}' fill='url(#g)' filter='url(#b)'/>`);
};
// Havadaki ışığın görünmediği yerler: nesnelerin ve masanın önü
const pusMaskesi = svg(`<defs>${bulanik}<mask id='m'><rect width='1376' height='768' fill='#fff'/><g filter='url(#b)' fill='#000'>${nesneler.map((n) => `<polygon points='${noktalar(n)}'/>`).join('')}<polygon points='600,330 640,312 706,316 738,360 734,425 798,468 828,540 832,640 468,640 478,478 540,462 608,428 600,380'/><rect x='0' y='636' width='1376' height='132'/></g></mask></defs><rect width='1376' height='768' fill='#fff' mask='url(#m)'/>`);
const maskeStili = (m: string) => `-webkit-mask-image: ${m}; mask-image: ${m};`;
// Işığın içinde süzülen toz zerrecikleri (her derlemede aynı dizilim için sabit tohumla)
let tohum = 7;
const rnd = () => { tohum = (tohum * 9301 + 49297) % 233280; return tohum / 233280; };
const zerreler = Array.from({ length: 22 }, () => ({
  t: Math.round(14 + rnd() * 62), l: Math.round(30 + rnd() * 42), s: Math.round(2 + rnd() * 3), o: (0.45 + rnd() * 0.5).toFixed(2),
}));
---
<section class="kahraman" aria-labelledby="kahraman-baslik">
  {ana.gorsel && (
    <div class="kahraman-gorsel">
      <div class="sahne" data-sahne>
        <img src={u(ana.gorsel)} alt={ana.gorselAciklamasi ?? ''} fetchpriority="high" decoding="async" />
        <div class="isik-pus" aria-hidden="true" style={maskeStili(pusMaskesi)}>
          {huzmeler.map((h) => <div class="h" data-aci={h.aci} data-gen={h.w} data-op={h.o} style={`width: ${h.w}px; margin-left: -${h.w / 2}px; transform: rotate(${h.aci}deg); opacity: ${h.o}; filter: blur(${h.b}px)`}></div>)}
        </div>
        <div aria-hidden="true">
          {golgeler.map((g) => <span class="masa-golge" data-golge data-egim={g.egim} data-nesne={g.nesne} style={`left: ${g.l}%; top: ${g.t}%; width: ${g.w}%; transform: skewX(${g.egim}deg)`}></span>)}
          {nesneler.map((n) => {
            const xs = n.nokta.map((p) => p[0]); const ys = n.nokta.map((p) => p[1]);
            const cx = ((Math.min(...xs) + Math.max(...xs)) / 2 / 1376) * 100; const cy = ((Math.min(...ys) + Math.max(...ys)) / 2 / 768) * 100;
            return (
              <>
                <span class="nesne-golge" data-nesne-golge style={`background-image: url(${u(ana.gorsel)}); ${maskeStili(maske(n, true))}`}></span>
                <span class="nesne-isik" data-nesne-isik data-x={cx.toFixed(2)} data-y={cy.toFixed(2)} style={`background-image: url(${u(ana.gorsel)}); ${maskeStili(maske(n, false))}`}></span>
              </>
            );
          })}
        </div>
        {zerreler.map((z) => <span class="zerre" style={`top: ${z.t}%; left: ${z.l}%; width: ${z.s}px; height: ${z.s}px; opacity: ${z.o}`}></span>)}
      </div>
      <div class="golge g-sol"></div>
      <div class="golge g-alt"></div>
      <div class="golge g-ust"></div>
      <div class="golge g-sag"></div>
    </div>
  )}
  <div class="kahraman-icerik">
    <div class="kap">
      <div class="kahraman-metin">
        {ana.ustBaslik && <span class="ust-baslik cizgili" style="color: var(--altin-acik)" data-giris>{ana.ustBaslik}</span>}
        <h1 id="kahraman-baslik" data-giris>
          <small>{site.unvan}</small>
          <span class="yaldiz">{site.ad}</span>
        </h1>
        <div data-giris><Sus /></div>
        {slogan && <p class="slogan" data-giris set:html={slogan} />}
        {ana.aciklama && <p class="aciklama" data-giris>{ana.aciklama}</p>}
        <div class="dugmeler" data-giris>
          <a class="dugme altin" href={u('/yazilar/')}>Yazıları keşfet</a>
          <a class="dugme cizgi" href={u('/yayinlar/')}>Akademik yayınlar</a>
        </div>
        {istatistikler.length > 0 && (
          <div class="sayilar" data-giris>
            {istatistikler.map((s) => <div><b data-say={s.sayi}>{s.sayi}</b><span>{s.etiket}</span></div>)}
          </div>
        )}
      </div>
    </div>
  </div>
</section>
